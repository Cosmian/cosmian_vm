[Unit]
Description=open and mount the encrypted /var/lib/cosmian_vm/container to /var/lib/cosmian_vm/data
Requires=multi-user.target dev-tpmrm0.device
After=multi-user.target dev-tpmrm0.device
# cache.init is written by the agent once its first initialization (LUKS container creation
# and mount) is complete: until then, the agent owns the container and must not race with this unit
ConditionPathExists=/var/lib/cosmian_vm/cache.init
StartLimitIntervalSec=0

[Service]
Type=oneshot
Restart=on-failure
RestartSec=10s
ExecStart=/bin/bash /root/mount_luks.sh
RemainAfterExit=yes

[Install]
WantedBy=default.target
