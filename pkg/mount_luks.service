[Unit]
Description=open and mount the encrypted /var/lib/cosmian_vm/container to /var/lib/cosmian_vm/data
Requires=multi-user.target dev-tpmrm0.device
After=multi-user.target dev-tpmrm0.device
StartLimitIntervalSec=0

[Service]
Type=oneshot
Restart=on-failure
RestartSec=10s
# exit code 2 means "no LUKS header yet" (first boot, before the agent's initialization):
# nothing to mount, and restarting would race with the agent creating the container
SuccessExitStatus=2
ExecStart=/bin/bash /root/mount_luks.sh
RemainAfterExit=yes

[Install]
WantedBy=default.target
